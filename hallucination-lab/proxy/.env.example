# Copy to .env (or export in the service unit) on CRMDEVSRV03.
# Read the real gateway URL and create the virtual key from
# /etc/litellm/config.yaml and the LiteLLM UI at deploy time.
# Do NOT commit real values (PRD section 9).
GATEWAY_BASE_URL=
GATEWAY_API_KEY=
LAB_MODEL=gemma-4-27b-it
VISION_ENABLED=0
# Must match FACULTY_NAME in frontend/src/config.js. Fictional stand-in until
# a colleague confirms; set FACULTY_NAME_IS_PLACEHOLDER=false there too.
FACULTY_NAME=Dr. Ellen Marsh
FACULTY_FIELD=nursing
RATE_LIMIT_PER_MIN=60
# RECORDED_DIR=../frontend/src/data/recorded
# STATIC_DIR=../frontend/dist
